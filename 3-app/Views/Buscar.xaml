<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AgendAi.Models"
             x:Class="AgendAi.Views.Buscar"
             BackgroundColor="{StaticResource Fundo}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="20,44,20,0" RowSpacing="14">

        <VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Buscar" Style="{StaticResource TituloSerif}" />
                    <Label x:Name="ResumoLabel" Style="{StaticResource Suave}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="⇅"
                        Style="{StaticResource BotaoIcone}"
                        VerticalOptions="Center"
                        Clicked="OnOrdenarClicked" />
            </Grid>

            <Border Style="{StaticResource CampoBorda}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="🔍" FontSize="14" VerticalOptions="Center" TextColor="{StaticResource TextoSuave}" />
                    <Entry x:Name="BuscaEntry"
                           Grid.Column="1"
                           Style="{StaticResource Campo}"
                           Placeholder="Nome, endereço ou serviço"
                           ReturnType="Search"
                           Completed="OnBuscar" />
                </Grid>
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="ChipsLayout" />
            </ScrollView>
        </VerticalStackLayout>

        <CollectionView x:Name="Lista" Grid.Row="1">
            <CollectionView.EmptyView>
                <Label Text="Nenhum estabelecimento encontrado."
                       Style="{StaticResource Suave}"
                       HorizontalOptions="Center"
                       Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Estabelecimento">
                    <Border Style="{StaticResource Cartao}" Margin="0,0,0,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEstabelecimentoTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="64"
                                    HeightRequest="64"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Background="{StaticResource GradienteHero}">
                                <Label Text="{Binding Inicial}"
                                       Style="{StaticResource TituloSerif}"
                                       TextColor="{StaticResource DouradoEscuro}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Nome}"
                                       Style="{StaticResource TituloCartao}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="{Binding Endereco}"
                                       Style="{StaticResource Suave}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="{Binding PrecoMinimoTexto}" Style="{StaticResource TextoDourado}" FontSize="13" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding NotaTexto}"
                                       TextColor="{StaticResource Dourado}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End" />
                                <Label Text="{Binding DistanciaTexto}"
                                       Style="{StaticResource Suave}"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="Carregando"
                           Grid.Row="1"
                           IsRunning="False"
                           IsVisible="False"
                           Color="{StaticResource Dourado}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
